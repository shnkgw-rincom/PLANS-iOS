+            case .batchFiles:
+                model.analyzeBatchFiles(urls)
+            case .batchFolder:
+                model.analyzeFolder(first)
+            case .modelFolder:
+                model.installModel(from: first, as: model.selectedVariant)
+            }
+        } catch {
+            model.error = error.localizedDescription
+        }
+    }
